generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum Module {
  STOCK
  INVOICES
}

enum TaxTreatment {
  STANDARD
  REVERSE_CHARGE
  INTRA_EU_SUPPLY
  EXPORT
  THIRD_COUNTRY_SERVICE
}

enum CustomerType {
  BUSINESS
  CONSUMER
}

enum SupplyKind {
  GOODS
  SERVICE
  ELECTRONIC_SERVICE
}

enum VatVerificationStatus {
  VALID
  INVALID
  UNAVAILABLE
  ERROR
}

enum EvidenceType {
  TRANSPORT_PROOF
  EXPORT_PROOF
  TAX_DOCUMENT
  OTHER
}

enum InvoiceStatus {
  DRAFT
  OPEN
  SENT
  PAID
  CANCELED
}

enum InvoiceType {
  INVOICE
  CREDIT_NOTE
}

enum InvoiceNumberCycle {
  YEARLY
  DAILY
  CUSTOM
}

enum OfferStatus {
  DRAFT
  OPEN
  ACCEPTED
  REJECTED
  CONVERTED
}

enum RecurringInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PriceAdjustmentType {
  ABSOLUTE
  PERCENTAGE
}

enum ExportPeriod {
  PREVIOUS_MONTH
  PREVIOUS_QUARTER
  PREVIOUS_YEAR
  ALL_TIME
}

enum BackupTarget {
  LOCAL
  SMB
}

enum BackupInterval {
  DAILY
  WEEKLY
  MONTHLY
}

enum MovementType {
  IN
  OUT
  ADJUST
}

enum MovementBillingStatus {
  PENDING
  INVOICED
  GIFTED
  CANCELED
}

enum DeliveryMethod {
  STOCK
  DISTRIBUTOR_DIRECT
}

enum DeliveryNoteStatus {
  ACTIVE
  CANCELED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  DIRECT_DEBIT
  PAYPAL
  OTHER
}

enum MailKind {
  INVOICE
  REMINDER
  EXPORT
  PORTAL_LOGIN
}

enum MailStatus {
  PENDING
  SIMULATED
  ACCEPTED
  PARTIALLY_REJECTED
  REJECTED
  FAILED
}

enum MailErrorCategory {
  CONFIGURATION
  RECIPIENT_REJECTED
  AUTHENTICATION
  CONNECTION
  TIMEOUT
  SERVER
  UNKNOWN
}

model User {
  id                        String                     @id @default(cuid())
  email                     String                     @unique
  name                      String
  passwordHash              String
  role                      Role                       @default(MEMBER)
  modules                   Module[]                   @default([STOCK, INVOICES])
  createdAt                 DateTime                   @default(now())
  movements                 Movement[]
  payments                  Payment[]
  deliveryNotes             DeliveryNote[]             @relation("CreatedDeliveryNotes")
  canceledDeliveryNotes     DeliveryNote[]             @relation("CanceledDeliveryNotes")
  deliveryNoteCancellations DeliveryNoteCancellation[]
  evidenceUploads           InvoiceEvidence[]
}

model Warehouse {
  id                String             @id @default(cuid())
  name              String             @unique
  location          String?
  createdAt         DateTime           @default(now())
  stocks            Stock[]
  movements         Movement[]
  invoiceLines      InvoiceLine[]
  offerLines        OfferLine[]
  deliveryNoteLines DeliveryNoteLine[]
}

model Item {
  id                String             @id @default(cuid())
  name              String
  sku               String?            @unique
  barcode           String?            @unique
  description       String?
  supplyKind        SupplyKind         @default(GOODS)
  createdAt         DateTime           @default(now())
  stocks            Stock[]
  movements         Movement[]
  invoiceLines      InvoiceLine[]
  offerLines        OfferLine[]
  deliveryNoteLines DeliveryNoteLine[]
}

model Stock {
  id          String    @id @default(cuid())
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseId String
  quantity    Int       @default(0)

  @@unique([itemId, warehouseId])
}

model CompanySettings {
  id                   String             @id @default("singleton")
  name                 String             @default("")
  street               String             @default("")
  zip                  String             @default("")
  city                 String             @default("")
  country              String             @default("Österreich")
  uid                  String             @default("")
  iban                 String             @default("")
  bic                  String             @default("")
  bankName             String             @default("")
  email                String             @default("")
  phone                String             @default("")
  invoicePrefix        String             @default("")
  invoiceNumberCycle   InvoiceNumberCycle @default(YEARLY)
  nextInvoiceNumber    Int                @default(1)
  offerPrefix          String             @default("ANG-")
  deliveryNotePrefix   String             @default("LS-")
  paymentDays          Int                @default(14)
  emailSubject         String             @default("Rechnung {nummer}")
  emailBody            String             @default("Sehr geehrte Damen und Herren,\n\nanbei erhalten Sie die Rechnung {nummer}.\n\nMit freundlichen Grüßen")
  lastInvoiceYear      Int                @default(0)
  lastInvoiceSeq       Int                @default(0)
  lastOfferYear        Int                @default(0)
  lastOfferSeq         Int                @default(0)
  lastDeliveryNoteYear Int                @default(0)
  lastDeliveryNoteSeq  Int                @default(0)
  autoReminders        Boolean            @default(false)
  reminderDays         Int                @default(7)
  maxReminders         Int                @default(3)
  reminderSubject      String             @default("Zahlungserinnerung zu Rechnung {nummer}")
  reminderBody         String             @default("Sehr geehrte Damen und Herren,\n\ndürfen wir Sie freundlich daran erinnern, dass die Rechnung {nummer} vom {datum} über {betrag} seit {tage} Tagen überfällig ist?\n\nBitte überweisen Sie den offenen Betrag auf das angegebene Konto. Sollte sich Ihre Zahlung mit dieser Erinnerung überschnitten haben, betrachten Sie dieses Schreiben bitte als gegenstandslos.\n\nMit freundlichen Grüßen")
  skontoPercent        Int                @default(0)
  skontoDays           Int                @default(0)
}

model InvoiceDailySequence {
  day     Int @id
  lastSeq Int @default(0)
}

model Customer {
  id                  String             @id @default(cuid())
  customerNumber      String?            @unique
  name                String
  contactPerson       String?
  email               String?
  street              String             @default("")
  zip                 String             @default("")
  city                String             @default("")
  country             String             @default("Österreich")
  countryCode         String             @default("AT")
  customerType        CustomerType       @default(BUSINESS)
  uid                 String?
  defaultTaxTreatment TaxTreatment       @default(STANDARD)
  paymentDays         Int?
  notes               String?
  createdAt           DateTime           @default(now())
  invoices            Invoice[]
  offers              Offer[]
  deliveryNotes       DeliveryNote[]
  recurringInvoices   RecurringInvoice[]
  movements           Movement[]
  vatVerifications    VatVerification[]
}

model PortalLoginToken {
  id            String    @id @default(cuid())
  email         String
  codeHash      String
  linkHash      String    @unique
  requestIpHash String?
  expiresAt     DateTime
  attempts      Int       @default(0)
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([email, createdAt])
  @@index([requestIpHash, createdAt])
  @@index([expiresAt])
}

model PortalSession {
  // Die ID ist bereits ein Hash des zufälligen Cookie-Werts. Damit ist ein
  // Datenbank-Dump allein nicht ausreichend, um eine Sitzung zu übernehmen.
  id        String   @id
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model SoftwareItem {
  id             String                 @id @default(cuid())
  name           String
  description    String?
  unitPrice      Decimal                @db.Decimal(10, 2)
  unit           String                 @default("Monat")
  active         Boolean                @default(true)
  supplyKind     SupplyKind             @default(ELECTRONIC_SERVICE)
  createdAt      DateTime               @default(now())
  invoiceLines   InvoiceLine[]
  offerLines     OfferLine[]
  recurringLines RecurringInvoiceLine[]
}

model Invoice {
  id                     String            @id @default(cuid())
  number                 String?           @unique
  type                   InvoiceType       @default(INVOICE)
  relatedInvoice         Invoice?          @relation("Storno", fields: [relatedInvoiceId], references: [id])
  relatedInvoiceId       String?
  stornoInvoices         Invoice[]         @relation("Storno")
  reminderCount          Int               @default(0)
  lastReminderAt         DateTime?
  status                 InvoiceStatus     @default(DRAFT)
  customer               Customer          @relation(fields: [customerId], references: [id])
  customerId             String
  customerName           String            @default("")
  customerAddress        String            @default("")
  customerUid            String?
  customerCountryCode    String            @default("AT")
  customerType           CustomerType      @default(BUSINESS)
  issueDate              DateTime
  dueDate                DateTime
  deliveryDate           DateTime?
  servicePeriodStart     DateTime?
  servicePeriodEnd       DateTime?
  taxTreatment           TaxTreatment      @default(STANDARD)
  taxDecisionReason      String?
  vatVerification        VatVerification?  @relation(fields: [vatVerificationId], references: [id], onDelete: SetNull)
  vatVerificationId      String?
  uidCheckOverrideReason String?
  notes                  String?
  netTotal               Decimal           @default(0) @db.Decimal(12, 2)
  taxTotal               Decimal           @default(0) @db.Decimal(12, 2)
  grossTotal             Decimal           @default(0) @db.Decimal(12, 2)
  paidTotal              Decimal           @default(0) @db.Decimal(12, 2)
  skontoGranted          Decimal           @default(0) @db.Decimal(12, 2)
  skontoPercent          Int               @default(0)
  skontoDays             Int               @default(0)
  recurringInvoice       RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id])
  recurringInvoiceId     String?
  sourceOffer            Offer?            @relation("OfferInvoice", fields: [sourceOfferId], references: [id], onDelete: SetNull)
  sourceOfferId          String?           @unique
  sentAt                 DateTime?
  paidAt                 DateTime?
  createdAt              DateTime          @default(now())
  lines                  InvoiceLine[]
  payments               Payment[]
  evidences              InvoiceEvidence[]
  mailEvents             MailEvent[]

  @@index([status, issueDate])
}

model MailEvent {
  id            String             @id @default(cuid())
  kind          MailKind
  status        MailStatus         @default(PENDING)
  recipient     String
  subject       String
  invoice       Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId     String?
  messageId     String?
  accepted      String[]           @default([])
  rejected      String[]           @default([])
  smtpResponse  String?
  errorCategory MailErrorCategory?
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime           @default(now())
  completedAt   DateTime?

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([invoiceId, createdAt])
}

model Offer {
  id                  String       @id @default(cuid())
  number              String?      @unique
  status              OfferStatus  @default(DRAFT)
  customer            Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId          String
  customerName        String       @default("")
  customerAddress     String       @default("")
  customerUid         String?
  customerCountryCode String       @default("AT")
  customerType        CustomerType @default(BUSINESS)
  issueDate           DateTime
  validUntil          DateTime
  deliveryDate        DateTime?
  servicePeriodStart  DateTime?
  servicePeriodEnd    DateTime?
  taxTreatment        TaxTreatment @default(STANDARD)
  notes               String?
  netTotal            Decimal      @default(0) @db.Decimal(12, 2)
  taxTotal            Decimal      @default(0) @db.Decimal(12, 2)
  grossTotal          Decimal      @default(0) @db.Decimal(12, 2)
  finalizedAt         DateTime?
  acceptedAt          DateTime?
  convertedAt         DateTime?
  createdAt           DateTime     @default(now())
  lines               OfferLine[]
  convertedInvoice    Invoice?     @relation("OfferInvoice")

  @@index([status, issueDate])
}

model OfferLine {
  id             String        @id @default(cuid())
  offer          Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId        String
  position       Int
  description    String
  quantity       Decimal       @db.Decimal(10, 2)
  unit           String        @default("Stk")
  unitPrice      Decimal       @db.Decimal(10, 2)
  taxRate        Int           @default(20)
  lineNet        Decimal       @db.Decimal(12, 2)
  supplyKind     SupplyKind    @default(SERVICE)
  softwareItem   SoftwareItem? @relation(fields: [softwareItemId], references: [id], onDelete: SetNull)
  softwareItemId String?
  item           Item?         @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId         String?
  warehouse      Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  warehouseId    String?
}

model DeliveryNote {
  id                   String                     @id @default(cuid())
  number               String                     @unique
  customer             Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId           String
  customerName         String
  customerAddress      String
  customerUid          String?
  issueDate            DateTime
  deliveryMethod       DeliveryMethod             @default(STOCK)
  distributor          String?
  distributorReference String?
  trackingNumber       String?
  status               DeliveryNoteStatus         @default(ACTIVE)
  canceledAt           DateTime?
  canceledReason       String?
  canceledBy           User?                      @relation("CanceledDeliveryNotes", fields: [canceledById], references: [id])
  canceledById         String?
  notes                String?
  createdAt            DateTime                   @default(now())
  createdBy            User                       @relation("CreatedDeliveryNotes", fields: [createdById], references: [id])
  createdById          String
  lines                DeliveryNoteLine[]
  cancellations        DeliveryNoteCancellation[]

  @@index([customerId, issueDate])
}

model DeliveryNoteLine {
  id                String                         @id @default(cuid())
  deliveryNote      DeliveryNote                   @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  deliveryNoteId    String
  position          Int
  item              Item                           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemId            String
  itemName          String
  itemSku           String?
  warehouse         Warehouse?                     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  warehouseId       String?
  warehouseName     String?
  quantity          Int
  canceledQuantity  Int                            @default(0)
  billingStatus     MovementBillingStatus          @default(PENDING)
  movement          Movement?                      @relation(fields: [movementId], references: [id], onDelete: Restrict)
  movementId        String?                        @unique
  invoiceLine       InvoiceLine?                   @relation("DeliveryNoteLineInvoiceLine")
  cancellationLines DeliveryNoteCancellationLine[]
}

model DeliveryNoteCancellation {
  id             String                         @id @default(cuid())
  deliveryNote   DeliveryNote                   @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  deliveryNoteId String
  reason         String
  canceledAt     DateTime                       @default(now())
  canceledBy     User                           @relation(fields: [canceledById], references: [id], onDelete: Restrict)
  canceledById   String
  lines          DeliveryNoteCancellationLine[]

  @@index([deliveryNoteId, canceledAt])
}

model DeliveryNoteCancellationLine {
  cancellation       DeliveryNoteCancellation @relation(fields: [cancellationId], references: [id], onDelete: Cascade)
  cancellationId     String
  deliveryNoteLine   DeliveryNoteLine         @relation(fields: [deliveryNoteLineId], references: [id], onDelete: Restrict)
  deliveryNoteLineId String
  quantity           Int

  @@id([cancellationId, deliveryNoteLineId])
}

model Payment {
  id        String        @id @default(cuid())
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  amount    Decimal       @db.Decimal(12, 2)
  date      DateTime
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  note      String?
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime      @default(now())

  @@index([invoiceId])
}

model InvoiceLine {
  id                       String            @id @default(cuid())
  invoice                  Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId                String
  position                 Int
  description              String
  quantity                 Decimal           @db.Decimal(10, 2)
  unit                     String            @default("Stk")
  unitPrice                Decimal           @db.Decimal(10, 2)
  taxRate                  Int               @default(20)
  lineNet                  Decimal           @db.Decimal(12, 2)
  supplyKind               SupplyKind        @default(SERVICE)
  softwareItem             SoftwareItem?     @relation(fields: [softwareItemId], references: [id], onDelete: SetNull)
  softwareItemId           String?
  item                     Item?             @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId                   String?
  warehouse                Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  warehouseId              String?
  sourceMovement           Movement?         @relation("MovementInvoiceLine", fields: [sourceMovementId], references: [id], onDelete: SetNull)
  sourceMovementId         String?           @unique
  sourceDeliveryNoteLine   DeliveryNoteLine? @relation("DeliveryNoteLineInvoiceLine", fields: [sourceDeliveryNoteLineId], references: [id], onDelete: SetNull)
  sourceDeliveryNoteLineId String?           @unique
  stockBookedByInvoice     Boolean           @default(false)
}

model RecurringInvoice {
  id           String                 @id @default(cuid())
  name         String
  customer     Customer               @relation(fields: [customerId], references: [id])
  customerId   String
  interval     RecurringInterval      @default(MONTHLY)
  nextRun      DateTime
  active       Boolean                @default(true)
  autoSend     Boolean                @default(true)
  taxTreatment TaxTreatment           @default(STANDARD)
  notes        String?
  createdAt    DateTime               @default(now())
  lines        RecurringInvoiceLine[]
  invoices     Invoice[]
}

model RecurringInvoiceLine {
  id                        String              @id @default(cuid())
  recurringInvoice          RecurringInvoice    @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  recurringInvoiceId        String
  position                  Int
  // Wenn softwareItemId gesetzt: Bezeichnung + Preis werden bei der Erzeugung
  // vom Softwareartikel gelesen (Preisänderungen wirken auf künftige Rechnungen).
  softwareItem              SoftwareItem?       @relation(fields: [softwareItemId], references: [id], onDelete: SetNull)
  softwareItemId            String?
  description               String?
  unitPrice                 Decimal?            @db.Decimal(10, 2)
  priceAdjustmentType       PriceAdjustmentType @default(ABSOLUTE)
  priceAdjustmentValue      Decimal             @default(0) @db.Decimal(10, 2)
  priceAdjustmentIsDiscount Boolean             @default(false)
  quantity                  Decimal             @db.Decimal(10, 2)
  unit                      String              @default("Stk")
  taxRate                   Int                 @default(20)
  supplyKind                SupplyKind          @default(SERVICE)
}

model VatVerification {
  id           String                @id @default(cuid())
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId   String
  countryCode  String
  vatNumber    String
  status       VatVerificationStatus
  checkedAt    DateTime              @default(now())
  requestDate  DateTime?
  name         String?
  address      String?
  requestId    String?
  errorMessage String?
  invoices     Invoice[]

  @@index([customerId, checkedAt])
  @@index([countryCode, vatNumber, checkedAt])
}

model InvoiceEvidence {
  id           String       @id @default(cuid())
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId    String
  type         EvidenceType
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  note         String?
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedById String
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?

  @@index([invoiceId, createdAt])
}

model ExportSchedule {
  id             String            @id @default(cuid())
  name           String
  active         Boolean           @default(true)
  interval       RecurringInterval @default(MONTHLY)
  nextRun        DateTime
  period         ExportPeriod      @default(PREVIOUS_MONTH)
  types          InvoiceType[]     @default([INVOICE])
  recipientEmail String
  emailSubject   String            @default("Belegexport {zeitraum}")
  emailBody      String            @default("Sehr geehrte Damen und Herren,\n\nanbei der Belegexport für {zeitraum}.\n\nMit freundlichen Grüßen")
  lastRunAt      DateTime?
  createdAt      DateTime          @default(now())
}

model BackupSettings {
  id                   String         @id @default("singleton")
  enabled              Boolean        @default(false)
  target               BackupTarget   @default(SMB)
  interval             BackupInterval @default(DAILY)
  nextRun              DateTime?
  localPath            String         @default("/backups")
  smbHost              String         @default("")
  smbPort              Int            @default(445)
  smbShare             String         @default("")
  smbPath              String         @default("invoice-erp")
  smbDomain            String         @default("")
  smbUsername          String         @default("")
  smbPasswordEncrypted String         @default("")
  lastRunAt            DateTime?
  lastSuccessAt        DateTime?
  lastError            String?
  runningSince         DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Movement {
  id               String                 @id @default(cuid())
  type             MovementType
  quantity         Int
  item             Item                   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId           String
  warehouse        Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseId      String
  user             User                   @relation(fields: [userId], references: [id])
  userId           String
  customer         Customer?              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId       String?
  billingStatus    MovementBillingStatus?
  invoiceLine      InvoiceLine?           @relation("MovementInvoiceLine")
  deliveryNoteLine DeliveryNoteLine?
  supplier         String?
  note             String?
  canceledAt       DateTime?
  canceledReason   String?
  canceledById     String?
  createdAt        DateTime               @default(now())

  @@index([itemId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([customerId, billingStatus])
}
